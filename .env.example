# ClawBody Configuration
# Give your OpenClaw AI agent a physical robot body!

# ==============================================================================
# REQUIRED: Speaches — local voice pipeline (STT + TTS)
# ==============================================================================
# URL of your running speaches instance.
# Set this in your .envrc so it can point at a remote host if needed.
SPEACHES_BASE_URL=http://localhost:8233/v1

# The model name passed to the speaches Realtime WebSocket endpoint.
# Speaches forwards this to its configured chat_completion_base_url (your vLLM).
# Set this to the model ID your vLLM server has loaded, e.g.:
#   meta-llama/Llama-3.1-8B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
SPEACHES_REALTIME_MODEL=gpt-4o-realtime-preview

# faster-whisper model to use for speech-to-text inside speaches.
# Must be downloaded/available on the speaches host.
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-small.en

# TTS voice (Kokoro voices: af_heart, af_bella, am_adam, bf_emma, bm_george, etc.)
SPEACHES_VOICE=af_heart

# API key sent to speaches — only needed if you set api_key in speaches config.
# Any non-empty string works otherwise.
# SPEACHES_API_KEY=speaches

# ==============================================================================
# NOTE: Speaches-side LLM configuration (set in speaches' own environment)
# ==============================================================================
# These vars live in speaches' .env / environment, NOT here:
#
#   CHAT_COMPLETION_BASE_URL=http://your-vllm-host:8000/v1
#   CHAT_COMPLETION_API_KEY=your-vllm-api-key-if-needed
#
# See: https://speaches.ai/configuration/

# ==============================================================================
# REQUIRED: OpenClaw Gateway
# ==============================================================================
# The URL where your OpenClaw gateway is running
OPENCLAW_GATEWAY_URL=http://192.168.1.100:18789

# Your OpenClaw gateway authentication token
# Find this in ~/.openclaw/openclaw.json under gateway.token
OPENCLAW_TOKEN=your-gateway-token

# Agent ID to use (default: main)
OPENCLAW_AGENT_ID=main

# Session key for conversation context - IMPORTANT!
# Use "main" (default) to share context with WhatsApp and other DM channels
# This allows the robot to be aware of all your conversations
OPENCLAW_SESSION_KEY=main

# ==============================================================================
# OPTIONAL: Features
# ==============================================================================
ENABLE_CAMERA=true
ENABLE_OPENCLAW_TOOLS=true

# ==============================================================================
# OPTIONAL: OpenAI (no longer used for the voice pipeline)
# ==============================================================================
# Only needed if you have other code that calls OpenAI directly.
# OPENAI_API_KEY=sk-your-openai-key
